# =============================================================================
# Quiz Generator 환경 변수
# =============================================================================
# 이 파일을 복사하여 .env로 저장하고 실제 값을 입력하세요.
# cp .env.example .env

# =============================================================================
# Coolify 배포 설정 (Coolify 사용 시에만)
# =============================================================================
# Coolify가 자동 생성하는 변수들 (수동 설정 불필요)
# SERVICE_FQDN_BACKEND=your-backend.your-domain.com
# SERVICE_FQDN_FRONTEND=your-frontend.your-domain.com
# SERVICE_URL_BACKEND=http://your-backend.your-domain.com
# SERVICE_URL_FRONTEND=http://your-frontend.your-domain.com

# =============================================================================
# 사이트 URL (프로덕션 배포 시 필수)
# =============================================================================
# OAuth 콜백 및 서버사이드 렌더링에서 올바른 origin 사용을 위해 필요
# 로컬 개발 시 생략 가능 (window.location.origin 사용)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# =============================================================================
# API 설정
# =============================================================================
# 백엔드 API URL (프론트엔드에서 호출)
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS 허용 origin (백엔드에서 사용)
# 프로덕션: https://your-domain.com 추가
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Supabase (https://supabase.com에서 프로젝트 생성)
# =============================================================================
# Project Settings > API에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings > API > service_role (비밀키 - 서버에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings > Database > Connection string에서 확인
SUPABASE_DB_PASSWORD=your-db-password

# 백엔드용 (NEXT_PUBLIC_SUPABASE_URL과 동일, 생략 시 자동 사용)
# SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}

# =============================================================================
# OpenAI (https://platform.openai.com에서 API Key 발급)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# =============================================================================
# LangSmith (선택사항 - LLM 디버깅/모니터링)
# =============================================================================
# https://smith.langchain.com에서 발급
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=quiz-generator

# =============================================================================
# E2E 테스트 (선택사항)
# =============================================================================
# Supabase에서 이메일/비밀번호 로그인이 가능한 테스트 계정
# Playwright 인증 테스트에 사용
# TEST_USER_EMAIL=test@example.com
# TEST_USER_PASSWORD=your-test-password
